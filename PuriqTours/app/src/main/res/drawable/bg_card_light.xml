<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo claro -->
    <solid android:color="#F5F7FA" />

    <!-- Bordes redondeados -->
    <corners android:radius="14dp" />

    <!-- Borde sutil -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- Padding interno -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />

</shape>
