<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@drawable/box_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagar con Yape"
        android:textColor="#2B746C"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="12dp"/>

    <ImageView
        android:id="@+id/imgQR"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:src="@drawable/qr_example"
        android:background="@android:color/white"
        android:padding="10dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMontoYape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monto: S/ 0.00"
        android:textColor="#2B746C"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCodigoOperacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cod. operación: PAY-000000"
        android:textColor="#666"
        android:textSize="15sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnYaPague"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ya pagué"
        android:textColor="@android:color/white"
        android:backgroundTint="#009688"
        android:padding="10dp"/>
</LinearLayout>
