<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp"
    android:elevation="3dp">

    <!-- IMAGEN -->
    <ImageView
        android:id="@+id/imgTour"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:src="@drawable/kuelap"
        android:layout_marginEnd="12dp"/>

    <!-- TEXTO -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvTourTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tour título"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTourLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvTourDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción corta..."
            android:textSize="12sp"
            android:textColor="#777"
            android:maxLines="2"
            android:layout_marginTop="2dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvTourStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:textSize="11sp"
                android:padding="4dp"
                android:background="@color/teal_700"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/tvTourRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★"
                android:textSize="11sp"
                android:layout_marginStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
