<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Estado -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Disponible"
        android:textStyle="bold"
        android:textColor="#1EA01A"
        android:textSize="16sp" />

    <!-- Selección de fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/box_bg"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnCalendarioDisponibilidad"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_calendar"
            app:tint="@color/teal_200" />

        <TextView
            android:id="@+id/tvFechaSeleccionada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Selecciona una fecha"
            android:textColor="#2B746C"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Selección de viajeros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/box_bg"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_persons"
            app:tint="@color/teal_200" />

        <TextView
            android:id="@+id/tvViajerosSeleccionados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="2 adultos"
            android:textColor="#2B746C"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Detalles -->
    <TextView
        android:id="@+id/tvDetalles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Detalles"
        android:textColor="#666"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnDetalles"
        android:layout_gravity="start"
        android:backgroundTint="@color/teal_700"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Detalles"
        android:textAllCaps="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

    <!-- Card del tour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/box_bg"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvTituloPopup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#2B746C" />

        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: S/. 330"
            android:textColor="#000"
            android:textSize="19sp"
            android:layout_marginTop="4dp" />

        <!-- 🔹 CONTENEDOR DINÁMICO DE HORARIOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horarios disponibles:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#2B746C"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/layoutHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">
            <!-- Los botones se crearán dinámicamente aquí en filas de 3 -->
        </LinearLayout>
    </LinearLayout>

    <!-- 🔹 BOTÓN DE RESERVA  -->
    <Button
        android:id="@+id/btnReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00695C"
        android:text="Reservar ahora"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

</LinearLayout>
