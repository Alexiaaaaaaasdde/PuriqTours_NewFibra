<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <include
        android:id="@+id/topAppBar"
        layout="@layout/top_app_bar_superadmin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CONTENIDO SCROLL -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationSuperAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título -->
            <LinearLayout
                android:id="@+id/logsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLogsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registro de Eventos"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#009688"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Buscador -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputSearchLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:startIconDrawable="@drawable/ic_search_teal"
                app:startIconTint="@color/teal_700">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar evento..."
                    android:textColor="#009688"
                    android:textColorHint="#80B5AD"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- botones intactos -->
                    <!-- (no cambio nada de ids ni estilos) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="General"
                        android:textColor="#009688"
                        app:strokeColor="#009688"
                        app:strokeWidth="2dp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUsuariosFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Usuarios"
                        android:textColor="#009688"
                        app:strokeColor="#009688"
                        app:strokeWidth="2dp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPagos"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Pagos"
                        android:textColor="#009688"
                        app:strokeColor="#009688"
                        app:strokeWidth="2dp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuias"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Guías"
                        android:textColor="#009688"
                        app:strokeColor="#009688"
                        app:strokeWidth="2dp"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmpresas"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Empresas"
                        android:textColor="#009688"
                        app:strokeColor="#009688"
                        app:strokeWidth="2dp"
                        android:backgroundTint="#FFFFFF"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Ordenar / Exportar -->
            <LinearLayout
                android:id="@+id/ordenarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Ordenar -->
                <LinearLayout
                    android:id="@+id/btnOrdenarLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/flechitas_superadmin"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ordenar"
                        android:textColor="#26A69A"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Exportar"
                    android:textAllCaps="false"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- AQUÍ VA TU RECYCLERVIEW DE LOGS -->
            <!-- (si lo tienes, va aquí y scrollea perfecto) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"/>

        </LinearLayout>
    </ScrollView>

    <!-- FOOTER -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationSuperAdmin"
        android:layout_width="0dp"
        android:layout_height="105dp"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_superadmin"
        app:itemIconTint="@color/teal_700"
        app:itemTextColor="@color/teal_700"
        app:labelVisibilityMode="labeled"
        app:itemBackground="@android:color/transparent"
        app:itemIconSize="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
