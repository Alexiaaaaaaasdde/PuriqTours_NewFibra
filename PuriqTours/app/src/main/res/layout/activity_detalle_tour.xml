<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cliente.DetalleTourActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#009688"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="Puriq Tours"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 🔹 Icono perfil -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:src="@drawable/imagen_perfil"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp"/>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 🔹 Contenido scrollable -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- 🔹 Flecha atrás -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Volver"
                app:tint="@color/teal_700"
                android:layout_marginBottom="8dp"/>
            <!-- 🔹 Título -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ciudadela de Kuélap"
                android:textColor="#2B746C"
                android:textSize="35sp"
                android:textStyle="bold" />
            <!-- 🔹 Nombre de la empresa -->
            <TextView
                android:id="@+id/tvEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Empresa del tour"
                android:textColor="#4A7B6D"
                android:textSize="16sp"
                android:textStyle="italic"/>

            <!-- 🔹 Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/ratingBar1"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="@color/teal_700"
                    android:rating="5"
                    android:stepSize="0.5" />

                <TextView
                    android:id="@+id/tvOpiniones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text=" "
                    android:textColor="#2B746C"
                    android:textSize="14sp" />


            </LinearLayout>

            <!-- 🔹 Imagen -->
            <ImageView
                android:id="@+id/imgTour"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/kuelap" />

            <!-- 🔹 Precio -->
            <TextView
                android:id="@+id/tvPreciokuelap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=" "
                android:textColor="#2B746C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 🔹 Descripción del tour -->
            <TextView
                android:id="@+id/tvDescripcionTour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aquí va la descripción del tour"
                android:textColor="#2B746C"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/tvSeleccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seleccionar fechas y viajeros"
                android:textColor="#2B746C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 🔹 Selección de fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/box_bg"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/btnCalendario"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_calendar"
                    app:tint="@color/teal_200" />


                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#2B746C"
                    android:text="Martes, 15 de Marzo de 2025"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- 🔹 Selección de viajeros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/box_bg"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_persons"
                    app:tint="@color/teal_200" />

                <TextView
                    android:id="@+id/tvViajeros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#2B746C"
                    android:text="2 adultos"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 🔹 Nota -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recuerde reservar con anticipación."
                android:textColor="#2B746C"
                android:textSize="14sp" />

            <!-- 🔹 Botón -->
            <Button
                android:id="@+id/btnDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#009688"
                android:text="Consultar disponibilidad"
                android:textColor="@android:color/white" />


        <!-- 🔹 Pregunta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#2B746C"
            android:text="¿Tienes alguna pregunta sobre la reservación?"
            android:textStyle="bold" />

        <!-- ⭐ BLOQUE DE CONTACTO DE EMPRESA (CORREGIDO Y CERRADO CORRECTAMENTE) -->
        <LinearLayout
            android:id="@+id/layoutEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtContactoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contáctanos"
                android:textColor="#2B746C"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- Contenedor horizontal logo + info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- LOGO -->
                <ImageView
                    android:id="@+id/imgEmpresaLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:padding="4dp"
                    android:visibility="gone" />

                <!-- DATOS DE CONTACTO -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1">

                    <!-- Teléfono -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/teal_700" />

                        <TextView
                            android:id="@+id/tvEmpresaTelefono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teléfono: ---"
                            android:textColor="#2B746C"
                            android:textSize="15sp"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/teal_700" />

                        <TextView
                            android:id="@+id/tvEmpresaEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email: ---"
                            android:textColor="#2B746C"
                            android:textSize="15sp"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- RUC -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_company"
                            app:tint="@color/teal_700" />

                        <TextView
                            android:id="@+id/tvEmpresaRuc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RUC: ---"
                            android:textColor="#2B746C"
                            android:textSize="15sp"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>


            <!-- 🔹 Opiniones de viajeros -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Opiniones de viajeros"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2B746C" />

            <!-- 🔥 CONTENEDOR DINÁMICO PARA VALORACIONES -->
            <LinearLayout
                android:id="@+id/contenedorOpiniones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <!-- Las opiniones se cargarán aquí dinámicamente -->
                <!-- Si no hay valoraciones, se mostrarán estas opiniones de ejemplo -->

                <!-- Opinión de ejemplo 1 (se ocultará si hay valoraciones reales) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOpinionEjemplo1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gonzalo C"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#000" />

                        <RatingBar
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/teal_700"
                            android:rating="5"
                            android:stepSize="0.5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escrito el 2 Julio del 2024"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fue una gran experiencia poder visitar este sitio arqueológico."
                            android:textSize="14sp"
                            android:textColor="#333" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Opinión de ejemplo 2 (se ocultará si hay valoraciones reales) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOpinionEjemplo2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foxi L"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#000" />

                        <RatingBar
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/teal_700"
                            android:rating="5"
                            android:stepSize="0.5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escrito el 10 Agosto del 2024"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Muy recomendado, el lugar es increíble y el servicio excelente."
                            android:textSize="14sp"
                            android:textColor="#333" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <!-- 🔹 Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/teal_700"
        app:itemTextColor="@color/teal_700"
        app:labelVisibilityMode="labeled"
        app:itemBackground="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemIconSize="70dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
