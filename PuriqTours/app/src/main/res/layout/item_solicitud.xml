<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_item_solicitud"
    android:padding="12dp"
    android:layout_marginVertical="6dp"
    android:elevation="2dp">

    <!-- 🔹 Parte visible -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Imagen -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgSolicitud"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"
            android:src="@drawable/ic_launcher_foreground" />

        <!-- Texto -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título de solicitud"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/black" />

            <!-- 🔹 NUEVO: Paga -->
            <TextView
                android:id="@+id/tvPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paga: S/ 00.00"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/teal_700"
                android:layout_marginTop="2dp" />

            <!-- 🔹 NUEVO: Estado -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Pendiente"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/darkgreen"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDescripcionCorta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Descripción corta..."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/black"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- 🔹 Parte expandible -->
    <LinearLayout
        android:id="@+id/layoutExpandible"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvDescripcionCompleta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción completa aquí."
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/black"
            android:lineSpacingExtra="2dp" />

        <!-- 🔹 Botones -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalles"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aceptar"
                android:layout_marginStart="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rechazar"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/holo_red_dark" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
