<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/teal_700"
        app:title="Detalles del tour"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white" />

    <!-- NestedScrollView principal -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título Datos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:layout_marginBottom="16dp" />

            <!-- Hora de inicio del tour -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora de inicio del tour:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvHoraInicio"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="8:00 AM"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp" />

            <!-- Duración del tour -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duración del tour:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDuracion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="6 horas"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp" />

            <!-- Costo por persona -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Costo por persona:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCosto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="30 soles"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp" />

            <!-- Idiomas ofrecidos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idiomas ofrecidos:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvIdiomas"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Español - Inglés"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp" />

            <!-- Región -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Región (Departamento):"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvRegion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cusco"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp" />

            <!-- Ubicación -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Machu Picchu"
                android:background="@drawable/rounded_edittext"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp" />

            <!-- Servicios extra -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios extra:"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp" />

            <!-- Contenedor dinámico de servicios extra -->
            <LinearLayout
                android:id="@+id/layoutServiciosExtrasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- Título Ruta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:layout_marginBottom="16dp" />

            <!-- Mapa placeholder -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/rounded_corners"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/map_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_corners" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mapa de ruta"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:padding="8dp"
                    android:layout_margin="8dp" />

            </FrameLayout>

            <!-- Contenedor dinámico de ubicaciones -->
            <LinearLayout
                android:id="@+id/layoutUbicacionesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Botones fijos en la parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnCerrar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cerrar"
            android:textSize="16sp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@color/gray_medium"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnEliminarTour"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Eliminar"
            android:textSize="16sp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@color/white"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnEditarTour"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Editar"
            android:textSize="16sp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
