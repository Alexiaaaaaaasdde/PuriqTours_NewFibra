<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- 🔹 TopBar fija -->
        <include layout="@layout/top_app_bar_superadmin"/>

        <!-- 🔹 Título Usuarios -->
        <LinearLayout
            android:id="@+id/usuariosHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/topAppBar"
            app:layout_constraintStart_toStartOf="parent">


            <TextView
                android:id="@+id/tvUsuariosTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuarios"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#009688"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 🔹 Botón Crear Usuario -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearUsuario"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="+ Crear usuario"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:paddingStart="2dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"

            app:icon="@drawable/ic_add_user"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white"
            app:backgroundTint="@color/teal_700"

            app:layout_constraintTop_toBottomOf="@id/usuariosHeader"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 🔹 Buscador -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputSearchUsuarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCrearUsuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:startIconDrawable="@drawable/ic_search_teal"
            app:startIconTint="@color/teal_700">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar usuario..."
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🔹 Botones de filtro -->
        <HorizontalScrollView
            android:id="@+id/usuariosFiltersScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/inputSearchUsuarios"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/usuariosFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClientes"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clientes"
                    android:textColor="#009688"
                    app:strokeColor="#009688"
                    app:strokeWidth="2dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuias"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Guías"
                    android:textColor="#009688"
                    app:strokeColor="#009688"
                    app:strokeWidth="2dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdministradores"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Administradores"
                    android:textColor="#009688"
                    app:strokeColor="#009688"
                    app:strokeWidth="2dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBloqueados"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Baneados"
                    android:textColor="#009688"
                    app:strokeColor="#009688"
                    app:strokeWidth="2dp"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Todos"
                    android:textColor="#009688"
                    app:strokeColor="#009688"
                    app:strokeWidth="2dp"
                    android:backgroundTint="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 🔹 Botón Ordenar -->
        <LinearLayout
            android:id="@+id/ordenarLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/usuariosFiltersScroll"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/flechitas_superadmin"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ordenar"
                android:textColor="#009688"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 🔹 Contenedor donde cargan los fragments -->
        <FrameLayout
            android:id="@+id/usuariosContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ordenarLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔹 Bottom bar -->
    <include layout="@layout/navigation_bottombar_superadmin"/>

</FrameLayout>
