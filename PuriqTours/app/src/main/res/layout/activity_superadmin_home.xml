<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F8F9FA">

    <include
        android:id="@+id/includeTopBar"
        layout="@layout/top_app_bar_superadmin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"

        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeTopBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationSuperAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Hey Superadmin -->
                <TextView
                    android:id="@+id/tvHeySuperadmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido, Superadmin"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#009688"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- KPIs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- Columna Izquierda -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <!-- Usuarios activos -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/avatar"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/tvActiveUsersCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="#009688"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Usuarios activos"
                                android:textColor="#009688"/>
                        </LinearLayout>

                        <!-- Empresas registradas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="24dp">

                            <ImageView
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/ic_company_superadmin"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/tvRegisteredCompaniesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="#009688"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Empresas registradas"
                                android:textColor="#009688"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Columna Derecha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <!-- Guías habilitados -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/ic_guide_superadmin"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/tvEnabledGuidesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="#009688"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guías habilitados"
                                android:textColor="#009688"/>
                        </LinearLayout>

                        <!-- Guías NO habilitados -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="24dp">

                            <ImageView
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/ic_guide_superadmin"
                                android:scaleType="centerInside"/>

                            <TextView
                                android:id="@+id/tvDisabledGuidesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="#009688"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guías no habilitados"
                                android:textColor="#009688"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:padding="16dp"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <!-- CARD 1: Rankings -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRankings"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="start"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#EAF6F9"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/imgCard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside"
                                android:src="@drawable/rankings"/>

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 2: Preferencias -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPreferencias"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="end"

                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#EAF6F9"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/preferencias"
                                android:scaleType="centerCrop"/>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 3: Actividad -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardActividad"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="start"

                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#EAF6F9"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/actividad"
                                android:scaleType="centerCrop"/>

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 4: Crecimiento -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCrecimiento"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="end"

                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#EAF6F9"
                        android:foreground="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/crecimiento"
                                android:scaleType="centerCrop"/>


                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>


                <!-- AQUI SÍ VA EL RECYCLERVIEW (FUERA DEL GRID) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTopTours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"/>


            </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationSuperAdmin"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_superadmin"
        app:itemIconTint="@color/teal_700"
        app:itemTextColor="@color/teal_700"
        app:labelVisibilityMode="labeled"
        app:itemBackground="@android:color/transparent"
        app:itemIconSize="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>