<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles del Tour"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2B746C"
            android:layout_marginBottom="12dp"/>

        <!-- HORA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora de inicio:"
                android:textStyle="bold"
                android:textColor="#2B746C"/>

            <TextView
                android:id="@+id/tvHoraInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM"
                android:textColor="#2B746C"/>
        </LinearLayout>

        <!-- IDIOMAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idiomas ofrecidos:"
                android:textStyle="bold"
                android:textColor="#2B746C"/>

            <TextView
                android:id="@+id/tvIdiomas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Español - Inglés"
                android:textColor="#2B746C"/>
        </LinearLayout>

        <!-- FECHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha del Tour:"
                android:textStyle="bold"
                android:textColor="#2B746C"/>

            <TextView
                android:id="@+id/tvFechaTour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marzo 15, 2025"
                android:textColor="#2B746C"/>
        </LinearLayout>

        <!-- RUTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#2B746C"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/imgMapaRuta"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ruta"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/containerRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- SERVICIOS EXTRA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios extra"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#2B746C"
                android:layout_marginBottom="8dp"/>

            <!-- 🔥 RecyclerView ÚNICO -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServiciosExtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Botones ÚNICOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnAgregarExtras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Agregar al Tour"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"/>

                <Button
                    android:id="@+id/btnSalir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Salir"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#F44336"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
