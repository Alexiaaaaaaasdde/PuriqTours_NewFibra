<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles del Tour"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2B746C"
            android:layout_marginBottom="12dp" />

        <!-- HORA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hora de inicio:"
                android:textStyle="bold"
                android:textColor="#2B746C" />

            <TextView
                android:id="@+id/tvHoraInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM"
                android:textColor="#2B746C" />
        </LinearLayout>

        <!-- IDIOMAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idiomas ofrecidos:"
                android:textStyle="bold"
                android:textColor="#2B746C" />

            <TextView
                android:id="@+id/tvIdiomas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Español - Inglés"
                android:textColor="#2B746C" />
        </LinearLayout>

        <!-- FECHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha del Tour:"
                android:textStyle="bold"
                android:textColor="#2B746C" />

            <TextView
                android:id="@+id/tvFechaTour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marzo 15, 2025"
                android:textColor="#2B746C" />
        </LinearLayout>

        <!-- RUTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#2B746C"
                android:layout_marginBottom="8dp" />

            <!-- 🗺️ VISTA PREVIA DEL MAPA (IMAGEN ESTÁTICA) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/imgMapaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#F5F5F5"
                    android:src="@drawable/ruta" />

                <!-- OVERLAY PARA HACER CLICK -->
                <View
                    android:id="@+id/overlayMapa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- ÍCONO DE AMPLIAR -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:src="@android:drawable/ic_menu_zoom"
                    android:background="@drawable/rounded_button"
                    android:backgroundTint="#80000000"
                    android:padding="8dp"
                    app:tint="@android:color/white" />
            </RelativeLayout>

            <!-- BOTÓN PARA VER MAPA COMPLETO -->
            <Button
                android:id="@+id/btnVerMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Ver Mapa Completo de la Ruta"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/teal_700"
                android:layout_marginBottom="8dp"/>

            <!-- LISTA DE PUNTOS DE LA RUTA -->
            <LinearLayout
                android:id="@+id/containerRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- SERVICIOS EXTRA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios extra"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#2B746C"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServiciosExtras"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="always"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnAgregarExtras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Agregar al Tour"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"/>

                <Button
                    android:id="@+id/btnSalir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Salir"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#F44336"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
