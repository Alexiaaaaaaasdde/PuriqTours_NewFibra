<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA">


    <!-- 🔹 Contenido Scrollable -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F5F7FA"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Card de Perfil -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <!-- Foto de perfil con badge -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profileImage"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:elevation="4dp"
                            app:shapeAppearanceOverlay="@style/RoundedImage"
                            app:strokeColor="#009688"
                            app:strokeWidth="4dp"/>

                        <!-- Badge de edición -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabEditPhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:src="@android:drawable/ic_menu_camera"
                            app:fabSize="mini"
                            app:backgroundTint="#009688"
                            app:tint="@android:color/white"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Título -->
                    <TextView
                        android:text="Mi Perfil"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#2B746C"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Subtítulo -->
                    <TextView
                        android:text="Información personal"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Información Personal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Sección: Datos Básicos -->
                    <TextView
                        android:text="Datos Básicos"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#009688"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Nombre -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_person"
                            app:tint="#009688" />


                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Nombres"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Apellidos -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Apellidos"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etApellido"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fecha de nacimiento -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cake"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Fecha de nacimiento"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etFechaNacimiento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="29 de enero 2001"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="8dp"/>

                    <!-- Sección: Documentación -->
                    <TextView
                        android:text="Documentación"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#009688"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Tipo de documento -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pin"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />


                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Tipo de documento"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etTipoDocumento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="DNI"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Número de documento -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />


                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Número de documento"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etNumeroDocumento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="8dp"/>

                    <!-- Sección: Contacto -->
                    <TextView
                        android:text="Contacto"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#009688"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Teléfono -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/stat_sys_phone_call"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Número telefónico"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etNumeroTelefonico"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"
                                android:maxLength="9"
                                android:inputType="phone"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_email"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Correo electrónico"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etCorreo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dirección -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_map"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Dirección"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etDireccion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="8dp"/>

                    <!-- Sección: Preferencias -->
                    <TextView
                        android:text="Preferencias"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#009688"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Idioma -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_btn_speak_now"
                            android:layout_marginEnd="12dp"
                            app:tint="#009688" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Idioma"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etIdioma"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#2B746C"
                                android:textSize="16sp"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:padding="0dp"/>
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de acción -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Actualizar datos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#009688"
                    android:textColor="@android:color/white"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    android:elevation="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Guardar cambios"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#00796B"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    android:elevation="4dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
