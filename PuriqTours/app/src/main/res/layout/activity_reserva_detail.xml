<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/teal_700"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Nombre del tour -->
                    <TextView
                        android:id="@+id/tvTourName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tour Machu Picchu"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp" />

                    <!-- Estado -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reservado"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_light"
                        android:layout_marginBottom="16dp" />

                    <!-- Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Fecha:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2025-03-15"
                            android:textSize="14sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- Hora -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Hora:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvHour"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="09:00"
                            android:textSize="14sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- Precio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Precio Total:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="S/ 330"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/teal_700" />
                    </LinearLayout>

                    <!-- Viajeros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Viajeros:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvTravelers"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2 adultos, 1 niño"
                            android:textSize="14sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- Método de pago -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Método de pago:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvMetodoPago"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Yape/Plin/GooglePay"
                            android:textSize="14sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- Código de operación -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Código Op.:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvCodigoOperacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PAY-480615"
                            android:textSize="14sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_light"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <!-- ID Cliente -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="ID Cliente:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvIdCliente"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="sKwEhtkzj6ele2D65PagxKCSvw22"
                            android:textSize="12sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- ID Guía -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="ID Guía:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvIdGuia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="P6GTiH4dIkaYDEZL1opF7wIDK7g2"
                            android:textSize="12sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- QR Start -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="QR Inicio:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvQrStart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="start"
                            android:textSize="12sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>

                    <!-- QR End -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="QR Fin:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:id="@+id/tvQrEnd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="end"
                            android:textSize="12sp"
                            android:textColor="@color/gray" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nota informativa -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esta reserva solo se puede visualizar. Para más acciones, gestiona desde la aplicación del guía."
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
